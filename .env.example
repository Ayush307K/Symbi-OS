# Local SQLite database. For Vercel, use a hosted libSQL/Turso URL instead.
DATABASE_URL=file:./placeholder.db
TURSO_AUTH_TOKEN=

# JWT secret for authentication (change this in production)
JWT_SECRET=your-jwt-secret-here

# OpenAI — optional for embeddings / semantic upgrades
OPENAI_API_KEY=sk-...

# Gmail SMTP — for email notifications (use a Gmail App Password)
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-gmail-app-password
