# PostgreSQL. Managed providers (Neon, Supabase) expose two connection strings
# for the same database, and both are required:
#
#   DATABASE_URL — the POOLED connection, routed through PgBouncer. Used by the
#     running application. Serverless functions open many short-lived
#     connections, and the pooler is what keeps Postgres from exhausting its
#     connection limit. Neon marks this host `-pooler`; Supabase serves it on
#     port 6543.
#
#   DIRECT_URL — the DIRECT connection, bypassing the pooler. Used only by
#     `prisma migrate` and `prisma db push`. Migrations issue statements that
#     PgBouncer's transaction pooling mode cannot carry (advisory locks, schema
#     DDL in a session), so running them through the pooled URL fails. Supabase
#     serves this on port 5432.
#
# Append `?sslmode=require` for both; managed Postgres requires TLS.
DATABASE_URL=postgresql://<user>:<password>@<pooled-host>:6543/postgres?pgbouncer=true&sslmode=require
DIRECT_URL=postgresql://<user>:<password>@<direct-host>:5432/postgres?sslmode=require

# Integration tests run against the local docker-compose database, never the
# application's. Defaults to the docker-compose credentials when unset.
TEST_DATABASE_URL=postgresql://symbi:symbi_local_dev@localhost:5432/symbi_dev

# Required: generate with `openssl rand -base64 48`.
JWT_SECRET=replace-with-at-least-32-random-characters
COOKIE_DOMAIN=
ONBOARDING_DOCUMENT_RETENTION_DAYS=730
PASSWORD_BREACH_CHECK_ENABLED=false
IP_HASH_PEPPER=replace-with-an-independent-random-secret
FIELD_ENCRYPTION_KEY=replace-with-an-independent-32-character-secret
APP_URL=http://localhost:3000

# Vercel Cron. Generate with `openssl rand -base64 48`; Vercel sends it in the
# Authorization header. Schedules are UTC: listing sync runs at 00:00 and the
# incremental embedding refresh follows at 03:00.
CRON_SECRET=
DAILY_LISTING_PROVIDERS=tradeindia,recycleinme
DAILY_LISTING_MAX_ROWS_PER_PROVIDER=500
IMPORTED_LISTING_STALE_DAYS=14
DAILY_EMBEDDING_BATCH_SIZE=50
DAILY_EMBEDDING_CONCURRENCY=4
DAILY_EMBEDDING_MAX_LISTINGS=500

# Sandbox verification and payment are intentionally explicit.
DEMO_VERIFICATION_ENABLED=true
DEMO_PAYMENTS_ENABLED=true

# Grounded RAG. Without a Gemini key, retrieval falls back to lexical and
# answer generation becomes extractive; never call that the semantic baseline.
GEMINI_API_KEY=
GEMINI_RAG_MODEL=gemini-flash-latest
RAG_GENERATION_PROVIDER=gemini
RAG_EVAL_ENABLED=false
RAG_EVAL_KEY=
RAG_EVAL_BASE_URL=http://localhost:3000
RAG_EVAL_TOP_K=6
RAG_EVAL_CONCURRENCY=4
EVAL_REFERENCE_DATE=2026-08-24T00:00:00.000Z

# Optional alternative provider.
OPENAI_API_KEY=

# Ranked marketplace feed. The provider is selected behind an interface; the
# built-in Gemini adapter requests and normalises 768-dimensional vectors.
LISTING_EMBEDDING_PROVIDER=gemini
LISTING_EMBEDDING_MODEL=gemini-embedding-001

# Real listing provider. Configure either a JSON API or the public provider feed.
LISTINGS_PROVIDER=tradeindia
REAL_LISTINGS_API_URL=
REAL_LISTINGS_API_KEY=

# Geocoding. With no endpoint, SymbiOS uses its offline India city/pincode
# centroid adapter and records moderate confidence; this is sufficient for
# discovery ranking, never represented as street-level routing. For production
# address precision, configure a licensed, self-hosted, or commercial
# Nominatim-compatible endpoint. Do not point regular bulk jobs at the public
# OpenStreetMap Nominatim service.
GEOCODING_API_URL=
GEOCODING_USER_AGENT=SymbiOS/1.0 (operations@example.com)
# Emergency deployment override only; normal production builds run the
# idempotent backfill after migrations/catalogue sync.
SKIP_GEOCODING_BACKFILL=false
# Emergency override only; normal production builds repair and validate all
# catalogue rows after synchronization and geocoding.
SKIP_CATALOG_NORMALIZATION=false

# Listing media. Production requires a private S3-compatible bucket.
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Gmail SMTP — for email notifications (use a Gmail App Password)
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-gmail-app-password
