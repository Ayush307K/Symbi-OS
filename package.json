{
  "name": "symbi-os",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9 <26"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "security:scan": "node scripts/check-sensitive-files.mjs",
    "security:scan:history": "node scripts/check-sensitive-files.mjs --history",
    "verify": "npm run check:env && npm run security:scan && npm run typecheck && npm test && npm run build && npm audit --omit=dev",
    "db:deploy": "node scripts/ensure-local-db.mjs && prisma migrate deploy",
    "start": "next start",
    "ingest": "npm run ingest:real",
    "ingest:real": "tsx scripts/import-real-listings.ts",
    "rag:index": "tsx scripts/rebuild-rag-index.ts",
    "feed:backfill-embeddings": "tsx scripts/backfill-listing-embeddings.ts",
    "feed:refresh-edges": "tsx scripts/refresh-material-edges.ts",
    "onboarding:cleanup-documents": "tsx scripts/cleanup-expired-onboarding-documents.ts",
    "postinstall": "prisma generate",
    "check:env": "tsx scripts/check-env.ts",
    "db:reset": "docker compose down -v && docker compose up -d --wait && npm run db:deploy && npm run ingest:real"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "$postcss",
    "sharp": "0.35.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1098.0",
    "@prisma/client": "6.19.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^16.6.1",
    "framer-motion": "^12.34.3",
    "jose": "^6.2.4",
    "lucide-react": "^0.575.0",
    "next": "^16.2.12",
    "nodemailer": "^9.0.3",
    "openai": "^6.22.0",
    "pdf-lib": "1.17.1",
    "postcss": "^8.5.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sharp": "0.35.3",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/nodemailer": "^7.0.11",
    "prisma": "6.19.2",
    "tsx": "^4.23.1",
    "vitest": "^4.1.10"
  }
}
