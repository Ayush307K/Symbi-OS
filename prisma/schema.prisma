datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  passwordHash     String
  role             String    @default("BOTH") // BUYER | SELLER | BOTH — what they do in the market
  isAdmin          Boolean   @default(false) // platform operator; orthogonal to role
  accountStatus    String    @default("ACTIVE") // ACTIVE | LOCKED | DISABLED
  tokenVersion     Int       @default(0)
  companyName      String
  companyId        String?
  mobile           String?
  emailVerifiedAt  DateTime?
  mobileVerifiedAt DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())

  addresses            Address[]
  cartItems            CartItem[]
  wishlistItems        WishlistItem[]
  orders               PurchaseOrder[]
  reviews              Review[]
  messageThreadsBuyer  MessageThread[]      @relation("ThreadBuyer")
  messageThreadsSeller MessageThread[]      @relation("ThreadSeller")
  messages             Message[]
  notifications        Notification[]
  sellerOnboarding     SellerOnboarding?
  sessions             Session[]
  authTokens           AuthToken[]
  securityEvents       SecurityEvent[]
  listingAssets        ListingAsset[]
  listingEvents        ListingEvent[]       @relation("ListingEventActor")
  demands              Demand[]
  demandProfile        BuyerDemandProfile?
  onboardingDocuments  OnboardingDocument[]
  safetyEvents         SafetyEvent[]
  company              Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId])
}

model Bid {
  id              String    @id @default(uuid())
  materialName    String
  materialId      String?
  listingId       String?
  quantity        Int
  pricePerUnit    Decimal   @db.Decimal(14, 2)
  currency        String    @default("INR")
  unit            String    @default("ton")
  terms           String?
  status          String    @default("PENDING")
  currentSequence Int       @default(1)
  idempotencyKey  String?   @unique
  bidderUserId    String
  bidderEmail     String
  bidderCompany   String
  sellerUserId    String?
  producerId      String?
  expiresAt       DateTime?
  acceptedAt      DateTime?
  decisionAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  listing        MarketplaceListing?   @relation(fields: [listingId], references: [id], onDelete: SetNull)
  revisions      OfferRevision[]
  events         OfferEvent[]
  reservation    InventoryReservation?
  order          PurchaseOrder?        @relation("AcceptedBidOrder")
  messageThreads MessageThread[]

  @@index([listingId])
  @@index([bidderUserId])
  @@index([sellerUserId])
  @@index([status])
}

model OfferRevision {
  id              String   @id @default(uuid())
  bidId           String
  sequence        Int
  createdByUserId String
  kind            String
  quantity        Int
  pricePerUnit    Decimal  @db.Decimal(14, 2)
  currency        String
  unit            String
  terms           String?
  status          String   @default("OPEN")
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  bid Bid @relation(fields: [bidId], references: [id], onDelete: Cascade)

  @@unique([bidId, sequence])
  @@index([bidId, createdAt])
}

model OfferEvent {
  id           String   @id @default(uuid())
  bidId        String
  actorUserId  String?
  type         String
  fromStatus   String?
  toStatus     String
  sequence     Int
  metadataJson String?
  createdAt    DateTime @default(now())

  bid Bid @relation(fields: [bidId], references: [id], onDelete: Cascade)

  @@index([bidId, createdAt])
  @@index([actorUserId])
}

model Company {
  id           String   @id
  name         String   @unique
  industry     String
  location     String
  carbonRating String
  latitude     Float
  longitude    Float
  capacity     Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  produces MaterialProducer[]
  upcycles MaterialUpcycler[]
  listings MarketplaceListing[]
  demands  Demand[]
  users    User[]
  matchesA PotentialMatch[]     @relation("MatchCompanyA")
  matchesB PotentialMatch[]     @relation("MatchCompanyB")
}

model WasteMaterial {
  id            String   @id
  name          String   @unique
  toxicityLevel String
  baseElement   String
  category      String
  description   String
  embeddingJson String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  producers      MaterialProducer[]
  upcyclers      MaterialUpcycler[]
  regulations    MaterialRegulation[]
  complements    MaterialComplement[] @relation("ComplementSource")
  complementedBy MaterialComplement[] @relation("ComplementTarget")
  listings       MarketplaceListing[]
  demands        Demand[]
  outgoingEdges  MaterialEdge[]       @relation("MaterialEdgeSource")
  incomingEdges  MaterialEdge[]       @relation("MaterialEdgeTarget")
}

model MarketplaceListing {
  id                   String                      @id
  title                String
  slug                 String                      @unique
  sourceType           String                      @default("synthetic")
  sourceName           String?
  sourceUrl            String?
  externalId           String?                     @unique
  rawQuantityText      String?
  rawLocationText      String?
  materialId           String
  sellerCompanyId      String
  category             String
  subcategory          String
  area                 String
  city                 String
  state                String
  country              String
  imageUrl             String                      @default("")
  pricePerUnit         Decimal                     @db.Decimal(14, 2)
  priceMode            String                      @default("FIXED")
  currency             String                      @default("INR")
  unit                 String                      @default("ton")
  minOrderQuantity     Int
  lotIncrement         Int                         @default(1)
  quantityAvailable    Int
  leadTimeDays         Int
  rating               Float
  responseRate         Int
  verified             Boolean                     @default(true)
  tradeAssurance       Boolean                     @default(true)
  yearsActive          Int
  ordersCompleted      Int
  description          String
  packaging            String
  handlingRequirements String                      @default("")
  paymentTerms         String
  pincode              String?
  latitude             Float?
  longitude            Float?
  availableFrom        DateTime?
  availableUntil       DateTime?
  safetyDeclaration    Boolean                     @default(false)
  qualityDeclaration   Boolean                     @default(false)
  ownershipDeclaration Boolean                     @default(false)
  authorityDeclaration Boolean                     @default(false)
  status               String                      @default("DRAFT")
  version              Int                         @default(1)
  submittedAt          DateTime?
  moderatedAt          DateTime?
  moderatedByUserId    String?
  moderationNote       String?
  activatedAt          DateTime?
  expiresAt            DateTime?
  archivedAt           DateTime?
  lastVerifiedAt       DateTime?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  embedding            Unsupported("vector(768)")?

  material           WasteMaterial          @relation(fields: [materialId], references: [id], onDelete: Cascade)
  seller             Company                @relation(fields: [sellerCompanyId], references: [id], onDelete: Cascade)
  cartItems          CartItem[]
  wishlistItems      WishlistItem[]
  orderItems         PurchaseOrderItem[]
  reviews            Review[]
  messageThreads     MessageThread[]
  bids               Bid[]
  inventoryMoves     InventoryMovement[]
  assets             ListingAsset[]
  events             ListingEvent[]
  matches            ListingMatch[]
  reservations       InventoryReservation[]
  safetyReviewReason String?

  @@index([category])
  @@index([category, subcategory])
  @@index([state])
  @@index([state, city, pincode])
  @@index([country])
  @@index([sourceType])
  @@index([sourceName])
  @@index([materialId])
  @@index([sellerCompanyId])
  @@index([status, updatedAt])
  @@index([status, category, updatedAt, id])
  @@index([status, pricePerUnit])
  @@index([status, quantityAvailable])
  @@index([status, availableFrom, availableUntil])
}

/// Cached buyer intent used by the ranked feed. The vector remains an
/// Unsupported field because Prisma does not natively serialize pgvector.
model BuyerDemandProfile {
  userId            String                      @id @map("user_id")
  profileText       String                      @map("profile_text")
  embedding         Unsupported("vector(768)")?
  historyEventCount Int                         @default(0) @map("history_event_count")
  sourceUpdatedAt   DateTime                    @map("source_updated_at")
  updatedAt         DateTime                    @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("buyer_demand_profiles")
}

/// Directed, weighted material graph. Traversal is intentionally implemented
/// with bounded SQL joins; no graph database or graph extension is involved.
model MaterialEdge {
  src       String   @map("src")
  dst       String   @map("dst")
  edgeType  String   @map("edge_type")
  weight    Float
  updatedAt DateTime @default(now()) @map("updated_at")

  source WasteMaterial @relation("MaterialEdgeSource", fields: [src], references: [id], onDelete: Cascade)
  target WasteMaterial @relation("MaterialEdgeTarget", fields: [dst], references: [id], onDelete: Cascade)

  @@id([src, dst, edgeType])
  @@index([src, edgeType, weight(sort: Desc)])
  @@index([dst, edgeType, weight(sort: Desc)])
  @@map("material_edges")
}

model SafetyEvent {
  id        String   @id @default(uuid())
  userId    String?
  listingId String?
  outcome   String
  ruleCode  String
  category  String?
  textHash  String
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([listingId, createdAt])
  @@index([outcome])
}

model ListingAsset {
  id             String   @id @default(uuid())
  listingId      String
  ownerUserId    String
  kind           String
  storageKey     String   @unique
  thumbnailKey   String?
  originalName   String
  mimeType       String
  sizeBytes      Int
  checksumSha256 String
  width          Int?
  height         Int?
  sortOrder      Int      @default(0)
  visibility     String   @default("PRIVATE")
  status         String   @default("READY")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  listing MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  owner   User               @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([listingId, kind, sortOrder])
  @@index([ownerUserId])
}

model ListingEvent {
  id           String   @id @default(uuid())
  listingId    String
  actorUserId  String?
  type         String
  fromStatus   String?
  toStatus     String?
  version      Int
  snapshotJson String?
  note         String?
  createdAt    DateTime @default(now())

  listing MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  actor   User?              @relation("ListingEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([listingId, createdAt])
  @@index([actorUserId])
  @@index([type])
}

model Address {
  id                 String   @id @default(uuid())
  userId             String
  label              String   @default("Office")
  contactName        String
  phone              String
  country            String   @default("India")
  state              String
  city               String
  district           String?
  area               String?
  locality           String?
  landmark           String?
  buildingName       String?
  floor              String?
  unitNumber         String?
  street             String
  pincode            String
  latitude           Float?
  longitude          Float?
  isDefaultShipping  Boolean  @default(false)
  isDefaultBilling   Boolean  @default(false)
  addressType        String   @default("SHIPPING")
  verificationStatus String   @default("UNVERIFIED")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  shippingOrders PurchaseOrder[] @relation("ShippingAddress")
  billingOrders  PurchaseOrder[] @relation("BillingAddress")

  @@index([userId])
  @@index([pincode])
}

model CartItem {
  id            String   @id @default(uuid())
  userId        String
  listingId     String
  quantity      Int
  priceSnapshot Decimal  @db.Decimal(14, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([listingId])
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([listingId])
}

model PurchaseOrder {
  id                  String   @id @default(uuid())
  orderNumber         String   @unique
  buyerUserId         String
  sourceBidId         String?  @unique
  status              String   @default("CREATED")
  paymentStatus       String   @default("PENDING")
  fulfillmentStatus   String   @default("UNFULFILLED")
  disputeStatus       String   @default("NONE")
  shippingAddressId   String?
  billingAddressId    String?
  subtotal            Decimal  @db.Decimal(14, 2)
  taxAmount           Decimal  @db.Decimal(14, 2)
  shippingAmount      Decimal  @db.Decimal(14, 2)
  discountAmount      Decimal  @default(0) @db.Decimal(14, 2)
  buyerFeeAmount      Decimal  @default(0) @db.Decimal(14, 2)
  sellerFeeAmount     Decimal  @default(0) @db.Decimal(14, 2)
  feeVersion          String   @default("fees-v1")
  totalAmount         Decimal  @db.Decimal(14, 2)
  currency            String   @default("INR")
  gstInvoice          Boolean  @default(true)
  purchaseOrderNumber String?
  notes               String?
  taxNote             String   @default("Tax not calculated in sandbox")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  buyer           User                   @relation(fields: [buyerUserId], references: [id], onDelete: Cascade)
  sourceBid       Bid?                   @relation("AcceptedBidOrder", fields: [sourceBidId], references: [id], onDelete: SetNull)
  shippingAddress Address?               @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  billingAddress  Address?               @relation("BillingAddress", fields: [billingAddressId], references: [id])
  items           PurchaseOrderItem[]
  demoPayments    DemoPayment[]
  inventoryMoves  InventoryMovement[]
  reservations    InventoryReservation[]
  events          OrderEvent[]
  invoice         Invoice?
  creditNote      CreditNote?
  messageThreads  MessageThread[]

  @@index([buyerUserId])
  @@index([status])
}

model PurchaseOrderItem {
  id              String   @id @default(uuid())
  orderId         String
  listingId       String
  sourceBidId     String?
  sellerCompanyId String
  title           String
  quantity        Int
  unit            String
  pricePerUnit    Decimal  @db.Decimal(14, 2)
  lineTotal       Decimal  @db.Decimal(14, 2)
  status          String   @default("RESERVED")
  createdAt       DateTime @default(now())

  order   PurchaseOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listing MarketplaceListing @relation(fields: [listingId], references: [id])

  @@index([orderId])
  @@index([listingId])
  @@index([sellerCompanyId])
}

model OrderEvent {
  id           String   @id @default(uuid())
  orderId      String
  actorUserId  String?
  type         String
  fromStatus   String?
  toStatus     String
  reasonCode   String?
  snapshotJson String
  createdAt    DateTime @default(now())

  order PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([actorUserId])
}

model Invoice {
  id            String   @id @default(uuid())
  orderId       String   @unique
  invoiceNumber String   @unique
  snapshotJson  String
  issuedAt      DateTime @default(now())
  createdAt     DateTime @default(now())

  order PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model CreditNote {
  id               String   @id @default(uuid())
  orderId          String   @unique
  creditNoteNumber String   @unique
  invoiceNumber    String
  reasonCode       String
  snapshotJson     String
  issuedAt         DateTime @default(now())
  createdAt        DateTime @default(now())

  order PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Review {
  id               String   @id @default(uuid())
  userId           String
  listingId        String
  rating           Int
  title            String?
  body             String
  mediaJson        String?
  verifiedPurchase Boolean  @default(false)
  helpfulCount     Int      @default(0)
  status           String   @default("PUBLISHED")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([listingId])
  @@index([userId])
}

model MessageThread {
  id              String   @id @default(uuid())
  listingId       String?
  bidId           String?
  orderId         String?
  buyerUserId     String
  sellerUserId    String?
  sellerCompanyId String?
  subject         String
  status          String   @default("OPEN")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  listing  MarketplaceListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  buyer    User                @relation("ThreadBuyer", fields: [buyerUserId], references: [id], onDelete: Cascade)
  seller   User?               @relation("ThreadSeller", fields: [sellerUserId], references: [id], onDelete: SetNull)
  messages Message[]
  bid      Bid?                @relation(fields: [bidId], references: [id], onDelete: SetNull)
  order    PurchaseOrder?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  reports  MessageReport[]

  @@index([buyerUserId])
  @@index([sellerUserId])
  @@index([listingId])
  @@index([bidId])
  @@index([orderId])
}

model Message {
  id              String    @id @default(uuid())
  threadId        String
  senderUserId    String
  body            String
  attachmentsJson String?
  status          String    @default("SENT")
  createdAt       DateTime  @default(now())
  readAt          DateTime?

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User          @relation(fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([senderUserId])
}

model MessageReport {
  id             String   @id @default(uuid())
  threadId       String
  reporterUserId String
  reasonCode     String
  details        String?
  status         String   @default("OPEN")
  createdAt      DateTime @default(now())

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([reporterUserId, status])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String
  actionUrl String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([readAt])
}

model SellerOnboarding {
  id                    String    @id @default(uuid())
  userId                String    @unique
  status                String    @default("DRAFT")
  currentStep           String    @default("BUSINESS")
  businessJson          String?
  taxJson               String?
  bankJson              String?
  kycJson               String?
  warehouseJson         String?
  policyJson            String?
  submittedAt           DateTime?
  reviewedAt            DateTime?
  reviewerNote          String?
  gstinHash             String?   @unique
  verificationProvider  String?
  verificationReference String?
  verifiedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents OnboardingDocument[]
  events    VerificationEvent[]
}

model OnboardingDocument {
  id             String   @id @default(uuid())
  onboardingId   String
  ownerUserId    String
  kind           String
  storageKey     String   @unique
  originalName   String
  mimeType       String
  sizeBytes      Int
  checksumSha256 String
  status         String   @default("READY")
  retentionUntil DateTime
  createdAt      DateTime @default(now())

  onboarding SellerOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  owner      User             @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@unique([onboardingId, kind])
  @@index([ownerUserId])
  @@index([retentionUntil])
}

model VerificationEvent {
  id           String   @id @default(uuid())
  onboardingId String
  actorUserId  String?
  type         String
  fromStatus   String?
  toStatus     String
  note         String?
  provider     String?
  reference    String?
  createdAt    DateTime @default(now())

  onboarding SellerOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)

  @@index([onboardingId, createdAt])
  @@index([actorUserId])
}

model Session {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  userAgent  String?
  ipHash     String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuthToken {
  id        String    @id @default(uuid())
  userId    String
  type      String // EMAIL_VERIFICATION | PASSWORD_RESET
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

model RateLimitBucket {
  key          String    @id
  count        Int       @default(0)
  windowStart  DateTime
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt
}

model SecurityEvent {
  id        String   @id @default(uuid())
  userId    String?
  type      String
  ipHash    String?
  metadata  String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model ListingImportRun {
  id              String    @id @default(uuid())
  provider        String
  status          String    @default("RUNNING")
  recordsSeen     Int       @default(0)
  recordsUpserted Int       @default(0)
  recordsRejected Int       @default(0)
  errorSummary    String?
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?

  @@index([provider])
  @@index([startedAt])
}

model KnowledgeDocument {
  id          String   @id @default(uuid())
  sourceType  String
  sourceId    String?
  sourceUrl   String?
  title       String
  contentHash String   @unique
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chunks KnowledgeChunk[]

  @@index([sourceType])
  @@index([sourceId])
}

model KnowledgeChunk {
  id         String @id @default(uuid())
  documentId String
  chunkIndex Int
  content    String
  // Same width and model as MarketplaceListing.embedding, so both pipelines
  // share one vector store and one HNSW/cosine configuration. Held as a real
  // pgvector column rather than JSON text: the previous store forced every
  // query to read all chunks and JSON.parse each 768-float array in the app.
  embedding     Unsupported("vector(768)")?
  tokenEstimate Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([documentId])
}

model DemoPayment {
  id             String    @id @default(uuid())
  orderId        String
  providerRef    String    @unique
  amount         Decimal   @db.Decimal(14, 2)
  currency       String    @default("INR")
  status         String    @default("CREATED")
  idempotencyKey String    @unique
  confirmedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  order PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model InventoryMovement {
  id             String   @id @default(uuid())
  listingId      String
  orderId        String?
  reservationId  String?
  quantityChange Int
  balanceAfter   Int
  reason         String
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())

  listing     MarketplaceListing    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  order       PurchaseOrder?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  reservation InventoryReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([listingId])
  @@index([orderId])
  @@index([reservationId])
}

model InventoryReservation {
  id            String    @id @default(uuid())
  listingId     String
  bidId         String?   @unique
  orderId       String?
  quantity      Int
  status        String    @default("ACTIVE")
  expiresAt     DateTime
  committedAt   DateTime?
  releasedAt    DateTime?
  releaseReason String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  listing   MarketplaceListing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bid       Bid?                @relation(fields: [bidId], references: [id], onDelete: SetNull)
  order     PurchaseOrder?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  movements InventoryMovement[]

  @@index([listingId, status])
  @@index([orderId])
  @@index([status, expiresAt])
}

model Regulation {
  id          String @id
  code        String @unique
  description String

  materials MaterialRegulation[]
}

model MaterialProducer {
  companyId  String
  materialId String

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  material WasteMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@id([companyId, materialId])
  @@index([materialId])
}

model MaterialUpcycler {
  companyId  String
  materialId String

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  material WasteMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@id([companyId, materialId])
  @@index([materialId])
}

model MaterialRegulation {
  materialId   String
  regulationId String

  material   WasteMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  regulation Regulation    @relation(fields: [regulationId], references: [id], onDelete: Cascade)

  @@id([materialId, regulationId])
  @@index([regulationId])
}

model MaterialComplement {
  sourceId String
  targetId String

  source WasteMaterial @relation("ComplementSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target WasteMaterial @relation("ComplementTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@id([sourceId, targetId])
  @@index([targetId])
}

model PotentialMatch {
  id              String   @id @default(uuid())
  company1Id      String
  company2Id      String
  score           Float
  sharedMaterials Int
  sharedNamesJson String
  computedAt      DateTime @default(now())

  company1 Company @relation("MatchCompanyA", fields: [company1Id], references: [id], onDelete: Cascade)
  company2 Company @relation("MatchCompanyB", fields: [company2Id], references: [id], onDelete: Cascade)

  @@unique([company1Id, company2Id])
  @@index([score])
}

model Demand {
  id            String    @id @default(uuid())
  companyId     String
  materialId    String
  userId        String?
  query         String
  category      String
  subcategory   String?
  quantity      Int
  unit          String
  maxPrice      Decimal?  @db.Decimal(14, 2)
  state         String?
  city          String?
  pincode       String?
  latitude      Float?
  longitude     Float?
  maxDistanceKm Float?
  availableBy   DateTime?
  status        String    @default("OPEN")
  matchVersion  String    @default("rules-v1")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  material WasteMaterial  @relation(fields: [materialId], references: [id], onDelete: Cascade)
  user     User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  matches  ListingMatch[]

  @@index([companyId, status])
  @@index([materialId])
  @@index([userId])
  @@index([category, status])
}

model ListingMatch {
  id                String   @id @default(uuid())
  demandId          String
  listingId         String
  score             Int
  version           String
  explanationJson   String
  inputSnapshotJson String
  status            String   @default("PROPOSED")
  convertedOrderId  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  demand  Demand             @relation(fields: [demandId], references: [id], onDelete: Cascade)
  listing MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([demandId, listingId])
  @@index([demandId, score])
  @@index([listingId, status])
  @@index([convertedOrderId])
}
